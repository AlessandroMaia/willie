{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "../.."
  },
  "files": {
    "includes": ["src/**", "*.ts", "*.json", "index.html", "!src-tauri"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error",
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "attributes": ["className"],
            "functions": ["cn", "cva", "clsx"]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/*",
                      "@/store/*",
                      "@/features/*",
                      "@/components/*",
                      "@/plugins/*",
                      "**/app/**",
                      "**/store/**",
                      "**/features/**",
                      "**/components/**",
                      "**/plugins/**"
                    ],
                    "message": "lib/ has no React and depends on nothing above it: not app, store, features, components or plugins. If lib needs what one of those offers, the logic belongs in lib/ itself."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/store/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/*",
                      "@/features/*",
                      "@/components/*",
                      "@/plugins/*",
                      "**/app/**",
                      "**/features/**",
                      "**/components/**",
                      "**/plugins/**"
                    ],
                    "message": "store/ reads only lib/ — never app, a feature, a component or a plugin. A screen depends on the store, never the other way around; move what the store needs down into lib/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/*",
                      "@/store/*",
                      "@/features/*",
                      "@/plugins/*",
                      "**/app/**",
                      "**/store/**",
                      "**/features/**",
                      "**/plugins/**"
                    ],
                    "message": "components/ reads only lib/ — never app, store, a feature or a plugin. A component two features share lives here; import it from the feature, not the other way around."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/health/**"],
      "linter": {
