                      "**/app/**",
                      "@/features/plugins/**",
                      "../plugins/**",
                      "../../plugins/**",
                      "@/features/profile-store/**",
                      "../profile-store/**",
                      "../../profile-store/**",
                      "@/features/profiles/**",
                      "../profiles/**",
                      "../../profiles/**",
                      "@/features/projects/**",
                      "../projects/**",
                      "../../projects/**",
                      "@/features/sandbox/**",
