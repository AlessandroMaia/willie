                      "../settings/**",
                      "../../settings/**",
                      "@/features/tools/**",
                      "../tools/**",
                      "../../tools/**",
                      "@/features/usage/**",
                      "../usage/**",
                      "../../usage/**"
                    ],
                    "message": "features/health never imports app/ or another feature. What health and another feature share moves down into components/, store/ or lib/."
